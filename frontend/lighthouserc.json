{
  "ci": {
    "collect": {
      "staticDistDir": "./frontend/dist",
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
        "interactive": ["warn", { "maxNumericValue": 3000 }]
      }
    },
    "upload": {
      "target": "filesystem"
    }
  }
}
